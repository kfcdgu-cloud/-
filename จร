-- ปุ่ม 2: เสกบล็อกดิน/ดินน้ำมัน (พร้อมแปะภาพ Decal บนบล็อก)
createMenuButton("เสกบล็อกดิน/ดินน้ำมัน", "🌱", function()
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local dirt = Instance.new("Part")
        dirt.Name = "DirtBlock"
        dirt.Size = Vector3.new(4, 4, 4)
        dirt.Position = char.HumanoidRootPart.Position + (char.HumanoidRootPart.CFrame.LookVector * 6)
        dirt.Material = Enum.Material.Grass
        dirt.Color = Color3.fromRGB(110, 80, 55)
        dirt.Anchored = true
        dirt.Parent = workspace
        
        -- แปะรูปภาพบนหน้าบล็อก
        local decal = Instance.new("Decal")
        decal.Texture = "rbxassetid://6031075931" -- ใส่ ID รูปภาพที่ต้องการแปะบนบล็อก
        decal.Face = Enum.NormalId.Front
        decal.Parent = dirt
    end
end)

-- ปุ่ม 3: ปิดมอนสเตอร์ (แก้แลค / Remove Mobs)
local isNoMobs = false
local mobBtn
mobBtn = createMenuButton("ปิดมอนสเตอร์ (แก้แลค): OFF", "👾", function()
    isNoMobs = not isNoMobs
    if isNoMobs then
        mobBtn.Text = "  👾  ปิดมอนสเตอร์ (แก้แลค): ON"
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and not game.Players:GetPlayerFromCharacter(obj) then
                obj:Destroy()
            end
        end
    else
        mobBtn.Text = "  👾  ปิดมอนสเตอร์ (แก้แลค): OFF"
    end
end)

-- ปุ่ม 4: โหมดกาก (ลดความละเอียดภาพแก้แลค)
local isLowGraphic = false
local lowBtn
