-- ปุ่ม 2: โหมดดินน้ำมัน (เปลี่ยนพื้นผิวทั้งแมพเป็นพลาสติกเรียบเพื่อลดแลค)
local isClayMode = false
local clayBtn
clayBtn = createMenuButton("โหมดดินน้ำมัน (แก้แลค): OFF", "🎨", function()
    isClayMode = not isClayMode
    if isClayMode then
        clayBtn.Text = "  🎨  โหมดดินน้ำมัน (แก้แลค): ON"
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("BasePart") then
                object.Material = Enum.Material.SmoothPlastic
            end
        end
    else
        clayBtn.Text = "  🎨  โหมดดินน้ำมัน (แก้แลค): OFF"
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("BasePart") then
                object.Material = Enum.Material.Plastic
            end
        end
    end
end)

-- ปุ่ม 3: ปิดมอนสเตอร์ (แก้แลค / Remove Mobs)
local isNoMobs = false
local mobBtn
mobBtn = createMenuButton("ปิดมอนสเตอร์ (แก้แลค): OFF", "👾", function()
    isNoMobs = not isNoMobs
    if isNoMobs then
        mobBtn.Text = "  👾  ปิดมอนสเตอร์ (แก้แลค): ON"
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and not game.Players:GetPlayerFromCharacter(obj) then
                obj:Destroy()
            end
        end
    else
        mobBtn.Text = "  👾  ปิดมอนสเตอร์ (แก้แลค): OFF"
    end
end)

